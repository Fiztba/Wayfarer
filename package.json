{
  "name": "wayfarer",
  "productName": "Wayfarer",
  "version": "0.4.12",
  "description": "A modern, feature-rich MUD client",
  "main": "out/main/index.js",
  "license": "MIT",
  "author": "Brandon Bridges",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "directory:tmc": "node --experimental-strip-types scripts/directory/sources/tmc.mts",
    "directory:tms": "node --experimental-strip-types scripts/directory/sources/tms.mts",
    "directory:mssp": "node --experimental-strip-types scripts/directory/sources/mssp.mts",
    "directory:vineyard": "node --experimental-strip-types scripts/directory/sources/vineyard.mts",
    "directory:grapevine": "node --experimental-strip-types scripts/directory/sources/grapevine.mts",
    "directory:mudverse": "node --experimental-strip-types scripts/directory/sources/mudverse.mts",
    "directory:build": "node --experimental-strip-types scripts/directory/build.mts"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wasmoon": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
